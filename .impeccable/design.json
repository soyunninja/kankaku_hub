  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Standard text-only primary variant; active-theme variables supply both themes.",
      "html": "<button class=\"ds-button-primary\">View measurements</button><button class=\"ds-button-primary\" disabled>Unavailable</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;white-space:nowrap;flex-shrink:0;border:0 solid transparent;border-radius:var(--radius-md, 8px);font-size:14px;font-weight:500;line-height:20px;height:36px;padding:8px 16px;cursor:pointer;transition:all 150ms cubic-bezier(0.4,0,0.2,1);font-family:var(--font-sans, \"Inter\", \"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", \"Yu Gothic UI\", \"Yu Gothic\", \"Meiryo\", \"Noto Sans JP\", \"Noto Sans CJK JP\", ui-sans-serif, system-ui, sans-serif);background:var(--primary, oklch(0.580 0.228 1));color:var(--primary-foreground, oklch(0.98 0 0));}.ds-button-primary:hover{background:color-mix(in oklab, var(--primary, oklch(0.580 0.228 1)) 90%, transparent);}.ds-button-primary:focus-visible{outline:none;border-color:var(--ring, oklch(0.580 0.228 1));box-shadow:0 0 0 3px color-mix(in oklab, var(--ring, oklch(0.580 0.228 1)) 50%, transparent);}.ds-button-primary:disabled{pointer-events:none;opacity:0.5;cursor:default;}.ds-button-primary[aria-invalid=\"true\"]{border-color:var(--destructive, oklch(0.567 0.245 27.325));box-shadow:0 0 0 3px color-mix(in oklab, var(--destructive, oklch(0.567 0.245 27.325)) 20%, transparent);}.ds-button-primary[data-theme=\"dark\"][aria-invalid=\"true\"]{box-shadow:0 0 0 3px color-mix(in oklab, var(--destructive, oklch(0.567 0.245 27.325)) 40%, transparent);}"
    },
