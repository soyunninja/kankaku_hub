{
  "name": "kankaku-hub",
  "private": true,
  "version": "0.1.0",
  "description": "PocketBase backend for kankaku: canonical clients/projects/tasks and synced task_entries/work_records.",
  "scripts": {
    "pb:download": "scripts/pb-download.sh",
    "dev": "scripts/dev.sh",
    "dev:all": "scripts/dev-all.sh",
    "pb:accounts": "scripts/create-dev-accounts.sh",
    "pb:seed": "node pocketbase/seed/seed.js --i-know",
    "hooks:test": "node --test pocketbase/pb_hooks/lib/*.test.js",
    "seed:test": "node --test pocketbase/seed/lib/*.test.js",
    "web:install": "pnpm --dir web install",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web generate",
    "web:test": "pnpm --dir web test",
    "web:lint": "pnpm --dir web lint",
    "web:typecheck": "pnpm --dir web typecheck",
    "site:install": "pnpm --dir site install",
    "site:dev": "pnpm --dir site dev",
    "site:build": "pnpm --dir site build",
    "site:preview": "pnpm --dir site preview",
    "site:test": "pnpm --dir site test:e2e",
    "site:check": "pnpm --dir site check && pnpm --dir site run i18n:check"
  }
}
